# The application itself needs no environment variables: every request goes to
# the relative path `/api/v1/...`, and whichever server sits in front resolves
# it — Vite's dev proxy locally (see vite.config.ts), or the Nginx config baked
# into the production image (see docker/ and frontend/nginx.conf) under Docker.
#
# The one overridable value is where that dev proxy points.

# Backend the Vite dev server proxies /api to.
# Default: http://127.0.0.1:8000 (the Python/FastAPI backend).
#
# Point this elsewhere if the backend runs on another host or port, e.g.:
#   VITE_API_PROXY_TARGET=http://127.0.0.1:9000
#
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
