# ---------------------------------------------------------------------------
# ProcureFlow - environment template.
# Copy to .env and edit.  Never commit the real .env.
# ---------------------------------------------------------------------------

# Local PostgreSQL (no Docker).  Driver is psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/procureflow

# Name of the database the reset command drops and recreates.
DB_NAME=procureflow

# Auth.  Change JWT_SECRET for anything that is not a local demo.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Password given to the four seeded demo accounts.
DEMO_PASSWORD=demo1234

# Where the Vite dev server runs (used for CORS).
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# LLM.  Provider-agnostic: leave LLM_API_KEY empty and the deterministic
# template fallback is used, so the demo works with no network.
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Sentence-transformers model used for embeddings (CPU, cosine similarity).
EMBEDDING_MODEL=all-MiniLM-L6-v2
