# INNOVATE-GOV backend (Python / FastAPI) configuration.
#
# Copy to `backend/.env` for local development, or set these as real
# environment variables. In Docker they are set directly in
# docker/docker-compose.yml.
#
# Every value below has a working local default in app/core/config.py, so the
# backend starts with no .env at all provided PostgreSQL is reachable.
#
# DO NOT COMMIT A REAL .env — it is gitignored for that reason.

# --- database -------------------------------------------------------------
# SQLAlchemy URL. The local demo role has no password, hence the bare colon.
# In Docker the host is the `postgres` service name on its internal port 5432.
DATABASE_URL=postgresql+psycopg://innovategov:@127.0.0.1:5433/innovategov

# --- auth -----------------------------------------------------------------
# Development-only secret. Replace before any deployment reachable from a
# network. Note that its *length* selects the HMAC algorithm, matching the
# behaviour of the backend this replaced — see app/security/jwt.py.
JWT_SECRET=dev-only-insecure-secret-change-me-please-1234567890
JWT_EXPIRY_MS=86400000

# --- CORS -----------------------------------------------------------------
# Comma-separated. Extra ports are listed because the Vite dev server falls
# back to the next free one when 5173 is taken.
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# --- files ----------------------------------------------------------------
FILE_STORAGE_PATH=../uploads

# --- server ---------------------------------------------------------------
SERVER_PORT=8000

# --- AI -------------------------------------------------------------------
# The matching pipeline runs in-process (app/ai/). "local" uses the bundled
# sentence-transformers model: fully offline, no API key, no outbound call.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Optional OpenAI-compatible provider. Left blank, the local model is used;
# setting EMBEDDING_PROVIDER=llm without a key also falls back to local.
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_CHAT_MODEL=gpt-4o-mini

# Weighted matching formula. Must sum to 1.0. These mirror the seeded
# `ai_matching_config` table, which the UI treats as the documented source.
WEIGHT_SEMANTIC_SIMILARITY=0.35
WEIGHT_TECHNOLOGY_MATCH=0.20
WEIGHT_DOMAIN_MATCH=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_READINESS=0.15

MATCH_TOP_N=8
