# Copy to .env for local (non-Docker) runs, or set these as real environment
# variables. In docker-compose, these are set directly in docker-compose.yml.

DATABASE_URL=jdbc:postgresql://127.0.0.1:5433/innovategov
DATABASE_USER=innovategov
DATABASE_PASSWORD=

JWT_SECRET=dev-only-insecure-secret-change-me-please-1234567890
JWT_EXPIRY_MS=86400000

# Comma-separated. Add a port here if your Vite dev server falls back to one
# not already listed (e.g. another local project is already using 5173).
CORS_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

AI_SERVICE_URL=http://127.0.0.1:8081

FILE_STORAGE_PATH=../uploads

SERVER_PORT=8001
