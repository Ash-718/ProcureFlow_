# Copy to .env and adjust as needed. Every value has a working local-dev default,
# so the fallback (offline) mode works with zero configuration.

DATABASE_URL=postgresql+psycopg://innovategov:@127.0.0.1:5433/innovategov

# "local" (default): sentence-transformers, fully offline, no API key needed.
# "llm": calls an OpenAI-compatible API — requires LLM_API_KEY, else silently
# falls back to "local" (see app/core/embeddings.py).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_CHAT_MODEL=gpt-4o-mini

# Weighted matching formula (Section 5) — must sum to 1.0
WEIGHT_SEMANTIC_SIMILARITY=0.35
WEIGHT_TECHNOLOGY_MATCH=0.20
WEIGHT_DOMAIN_MATCH=0.15
WEIGHT_EXPERIENCE=0.15
WEIGHT_READINESS=0.15

MATCH_TOP_N=8

CORS_ALLOWED_ORIGIN=http://localhost:5173
